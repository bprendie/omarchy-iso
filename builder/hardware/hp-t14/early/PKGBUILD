pkgname=omarchy-hw-snapdragon-early-experimental
pkgver=0.3
pkgrel=2
pkgdesc='HP and ThinkPad boot prerequisites and camera buffer access for Dragon'
arch=('any')
license=('MIT')
depends=('mkinitcpio' 'linux-firmware-qcom')
options=('!strip' '!debug')
package() {
  install -Dm755 "$startdir/dragon_hp_thinkpad" "$pkgdir/usr/lib/initcpio/install/dragon_hp_thinkpad"
  install -Dm755 "$startdir/dragon_hp_thinkpad.runtime" "$pkgdir/usr/lib/initcpio/hooks/dragon_hp_thinkpad"
  install -Dm644 "$startdir/zzzz-dragon-hp-thinkpad.conf" "$pkgdir/etc/mkinitcpio.conf.d/zzzz-dragon-hp-thinkpad.conf"
  install -Dm644 "$startdir/70-omarchy-camera-dma-heap.rules" "$pkgdir/usr/lib/udev/rules.d/70-omarchy-camera-dma-heap.rules"
}
